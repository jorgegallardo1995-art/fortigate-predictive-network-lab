# =============================================================================
# FortiGate Predictive Network Collector - environment file
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env
# NEVER commit ".env" to git. The API token is a secret.
# =============================================================================

# --- FortiGate REST API ------------------------------------------------------
# Host WITHOUT scheme (https:// is added automatically). May be IP or FQDN.
FORTIGATE_HOST=10.254.0.1
FORTIGATE_PORT=443
# REST API key generated in: System > Administrators > REST API Admin.
# The admin profile MUST be read-only. Paste the key here, never in chat/logs.
FORTIGATE_API_TOKEN=
# Separate WRITE token for controlled WAN fault injection (nightly outage /
# bandwidth ramps). Leave EMPTY to disable. Issue it to a REST API admin whose
# accprofile has WRITE on netgrp (system.interface) only, trusted-host = Pi IP.
FORTIGATE_CONTROL_TOKEN=
# Single-VDOM device -> keep "root".
FORTIGATE_VDOM=root
# Self-signed certificate on the FortiGate -> false. Set true if you install a CA-signed cert.
VERIFY_SSL=false
# Seconds.
FORTIGATE_TIMEOUT=10
FORTIGATE_MAX_RETRIES=3

# --- Collector mode --------------------------------------------------------
# true  -> generate synthetic data, data_source=MOCK  (development on the Mac)
# false -> query the real FortiGate,  data_source=REAL (production on the Pi)
MOCK_MODE=true

# --- Paths ---------------------------------------------------------------------
# Base directory for the database, exports and backups.
# Development (Mac): leave as "data" (relative to the project root).
# Production (Pi):   e.g. /mnt/data/fortigate  or  /var/lib/fortigate-collector
DATA_DIR=data
# Optional: full SQLAlchemy URL. If set, overrides the SQLite file in DATA_DIR.
# Use this the day you migrate to PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fortigate
DATABASE_URL=

# --- Web dashboard -----------------------------------------------------------
# Development (Mac): 127.0.0.1  (localhost only)
# Production  (Pi):  0.0.0.0    (reachable from the Mac over the LAN)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# --- Research / dataset -----------------------------------------------------
# IANA timezone used for the "local" timestamps (UTC is always the primary reference).
TIMEZONE=America/Santiago
# Anonymise the serial number in exports and research metadata.
ANONYMIZE_SERIAL=true

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
