# --- Secrets / environment ---
.env
*.env
!.env.example

# --- Data (never version the experimental dataset) ---
data/*.db
data/*.db-wal
data/*.db-shm
data/exports/*
data/backups/*
!data/exports/.gitkeep
!data/backups/.gitkeep

# --- Logs ---
logs/*.log
logs/*.log.*
!logs/.gitkeep

# --- Local runtime config (keep config.example.yaml tracked) ---
config/config.local.yaml

# --- Research artifacts generated at runtime ---
research_metadata.json

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS / IDE ---
.DS_Store
.vscode/
.idea/
{{*}}/

# local dev server stdout
logs/uvicorn.out
