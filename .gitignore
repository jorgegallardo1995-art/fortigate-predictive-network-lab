# --- Secrets / environment ---
.env
*.env
!.env.example

# --- Data (never version the experimental dataset) ---
data/*.db
data/*.db-wal
data/*.db-shm
data/exports/*
data/backups/*
!data/exports/.gitkeep
!data/backups/.gitkeep

# ML training runs (models, scalers, histories) - regenerate with ml/train.py.
# Keep run_metadata.json/metrics.json out too; publish results deliberately
# (see ml/README.md) rather than via git.
data/models/*
!data/models/.gitkeep

# --- Logs ---
logs/*.log
logs/*.log.*
!logs/.gitkeep

# --- Local runtime config (keep config.example.yaml tracked) ---
config/config.local.yaml

# --- Research artifacts generated at runtime ---
research_metadata.json

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS / IDE ---
.DS_Store
.vscode/
.idea/
{{*}}/

# local dev server stdout
logs/uvicorn.out

# Local analysis snapshot (never commit the 1GB DB) + monitor logs
/snap.db
/snap.db-shm
/snap.db-wal
data/monitor/
